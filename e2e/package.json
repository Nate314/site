{
  "name": "nathan-gawith-site-e2e",
  "private": true,
  "version": "1.0.0",
  "description": "Playwright end-to-end tests for the site, run against an already running instance",
  "scripts": {
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:smoke": "playwright test --grep @smoke",
    "typecheck": "tsc --noEmit",
    "report": "playwright show-report"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "^22.0.0",
    "typescript": "~5.9.0"
  }
}
